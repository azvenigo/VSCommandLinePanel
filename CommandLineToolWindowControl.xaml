<UserControl x:Class="VS_LaunchArguments.CommandLineToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             IsKeyboardFocusWithinChanged="OnIsKeyboardFocusWithinChanged">

    <UserControl.Resources>
        <Style x:Key="VsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"/>
            <Setter Property="Foreground"               Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="VerticalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalAlignment"      Value="Stretch"/>
        </Style>

        <Style x:Key="ScratchpadToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"/>
            <Setter Property="Opacity"          Value="0.45"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Focusable"        Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <Setter Property="Opacity"     Value="1.0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"/>
            <Setter Property="Opacity"          Value="0.45"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Focusable"        Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <Setter Property="Opacity"     Value="1.0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Delete (trashcan) button shown on hover for each history row -->
        <Style x:Key="HistoryDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="3"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Visibility"      Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Reveal when the row is hovered -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Subtle hover background on the button itself -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarHoverBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">

        <!-- Scratchpad popup -->
        <Popup x:Name="ScratchpadPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Top"
               VerticalOffset="-30"
               StaysOpen="True"
               Opened="ScratchpadPopup_Opened">
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                            Padding="6,3">
                        <TextBlock Text="Scratchpad"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    </Border>
                    <TextBox Grid.Row="1"
                             x:Name="ScratchpadTextBox"
                             Style="{StaticResource VsTextBoxStyle}"
                             BorderThickness="0"
                             Height="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             ToolTip="Scratchpad — persisted per solution"/>
                </Grid>
            </Border>
        </Popup>

        <!-- History dropdown popup — lifecycle managed entirely in code -->
        <Popup x:Name="HistoryPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Top"
               StaysOpen="True">
            <Border x:Name="HistoryPopupContent"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar — shows exe name -->
                    <Border Grid.Row="0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                            Padding="6,3">
                        <TextBlock x:Name="HistoryHeaderText"
                                   Text="Command history"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="HistoryListBox"
                             MaxHeight="400"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="HistoryListBox_KeyDown"
                             MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Command}"
                                               FontFamily="Consolas"
                                               TextTrimming="None"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TimeText}"
                                               Margin="20,0,4,0"
                                               Opacity="0.55"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource HistoryDeleteButtonStyle}"
                                            Click="DeleteHistoryItem_Click"
                                            ToolTip="Remove from history">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- Main row: toolbar | Args | splitter | Working Dir -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbar: scratchpad toggle + history button -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,2,0">
                <ToggleButton x:Name="ScratchpadToggle"
                              Style="{StaticResource ScratchpadToggleStyle}"
                              Width="16"
                              IsChecked="False"
                              Checked="ScratchpadToggle_Checked"
                              Unchecked="ScratchpadToggle_Unchecked"
                              ToolTip="Toggle scratchpad popup">
                    <TextBlock Text="🗎" FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                </ToggleButton>

                <Button x:Name="HistoryButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="16" Margin="2,0,0,0"
                        Click="HistoryButton_Click"
                        ToolTip="Show command history (%LOCALAPPDATA%\&lt;exename&gt;_history)">
                    <TextBlock Text="↺" FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                </Button>
            </StackPanel>

            <!-- Args -->
            <Grid Grid.Column="1">
                <TextBox x:Name="ArgsTextBox"
                         Style="{StaticResource VsTextBoxStyle}"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         MaxLines="1"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         TextChanged="ArgsTextBox_TextChanged"
                         DataObject.Pasting="OnSingleLinePasting"
                         ToolTip="Command-line arguments for the active debug configuration"/>
                <TextBlock IsHitTestVisible="False"
                           Text="Command-line arguments..."
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"
                           Opacity="0.4"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=ArgsTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>

            <!-- Working Dir -->
            <Grid Grid.Column="3">
                <TextBox x:Name="WorkingDirTextBox"
                         Style="{StaticResource VsTextBoxStyle}"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         MaxLines="1"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         TextChanged="WorkingDirTextBox_TextChanged"
                         DataObject.Pasting="OnSingleLinePasting"
                         ToolTip="Working directory for the active debug configuration"/>
                <TextBlock IsHitTestVisible="False"
                           Text="Working directory..."
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"
                           Opacity="0.4"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=WorkingDirTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
